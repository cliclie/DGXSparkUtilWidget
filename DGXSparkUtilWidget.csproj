<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DGXSparkUtilWidget</RootNamespace>
    <AssemblyName>DGXSparkUtilWidget</AssemblyName>
    <!-- プログラムアイコン -->
    <ApplicationIcon>images\DGXSpark.ico</ApplicationIcon>
    <!-- 単一ファイル公開設定 -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2651.64" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="images\DGXSpark.ico" />
  </ItemGroup>

  <!-- 診断用ヘルパー（PowerShell テスト用 P/Invoke）をアプリビルドから除外 -->
  <ItemGroup>
    <Compile Remove="tools\**\*.cs" />
  </ItemGroup>

</Project>
