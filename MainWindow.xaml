<Window x:Class="DGXSparkUtilWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="DGX Spark Utility"
        Width="800" Height="600"
        MinWidth="400" MinHeight="300"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="True"
        WindowStartupLocation="Manual"
        Icon="images/DGXSpark.ico"
        Loaded="MainWindow_Loaded">

    <!-- ルートの角丸Border -->
    <!-- 全体透過: WPF レイヤーは完全透明（AllowsTransparency のピクセル単位 alpha）にし、
         WebView2 ホストウィンドウ（Chrome_WidgetWin_1）へ LWA_ALPHA を適用することで
         WebView2 領域を含むウィンドウ全体がデスクトップに対してスライダー指定の透明度で透ける。 -->
    <Border x:Name="RootBorder"
            CornerRadius="10"
            Background="Transparent"
            ClipToBounds="True"
            MouseLeftButtonDown="RootBorder_MouseLeftButtonDown"
            MouseEnter="RootBorder_MouseEnter"
            MouseLeave="RootBorder_MouseLeave">
        <Grid>
            <!-- WebView2 メインコンテンツ -->
            <wv2:WebView2 x:Name="WebView"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"/>

        </Grid>
    </Border>
</Window>

