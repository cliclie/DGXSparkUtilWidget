<Window x:Class="DGXSparkUtilWidget.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="設定"
        Width="440" Height="340"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Icon="images/DGXSpark.ico">

    <Window.Resources>
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="#FF3A3A4E"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#FF4A4A60"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#FF5A5A70"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DialogCloseButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#E81123"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- ルートの角丸Border -->
    <Border x:Name="RootBorder"
            CornerRadius="10"
            Background="#FF1E1E2E"
            MouseLeftButtonDown="RootBorder_MouseLeftButtonDown">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- タイトルバー -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <TextBlock Text="設定"
                           FontSize="16" FontWeight="SemiBold"
                           Foreground="#E0E0E0"
                           VerticalAlignment="Center"/>
                <Button x:Name="BtnClose"
                        Style="{StaticResource DialogCloseButtonStyle}"
                        HorizontalAlignment="Right"
                        Click="BtnClose_Click"
                        ToolTip="閉じる">
                    <Path Data="M 5,5 L 15,15 M 15,5 L 5,15"
                          Stroke="#E0E0E0" StrokeThickness="1.5"/>
                </Button>
            </Grid>

            <!-- 接続先URL -->
            <StackPanel Grid.Row="1">
                <TextBlock Text="接続先URL"
                           Foreground="#B0B0C0" FontSize="13"
                           Margin="0,0,0,4"/>
                <TextBox x:Name="TxtUrl"
                         Height="32"
                         Padding="8,4"
                         FontSize="13"
                         Background="#FF2A2A3E"
                         Foreground="#E0E0E0"
                         BorderBrush="#FF3A3A4E"
                         BorderThickness="1"/>
            </StackPanel>

            <!-- 透過率 -->
            <StackPanel Grid.Row="2" Margin="0,16,0,0">
                <Grid Margin="0,0,0,4">
                    <TextBlock Text="透過率（不透明度）"
                               Foreground="#B0B0C0" FontSize="13"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="LblOpacity"
                               Text="1.00"
                               Foreground="#E0E0E0" FontSize="13"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"/>
                </Grid>
                <Slider x:Name="OpacitySlider"
                        Minimum="0.2" Maximum="1.0"
                        Value="1.0"
                        IsSnapToTickEnabled="False"
                        VerticalAlignment="Center"
                        Height="24"
                        ValueChanged="OpacitySlider_ValueChanged"/>
            </StackPanel>

            <!-- アクションボタン -->
            <StackPanel Grid.Row="4"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,12,0,0">
                <Button x:Name="BtnCancel"
                        Content="キャンセル"
                        Style="{StaticResource ActionButtonStyle}"
                        Click="BtnCancel_Click"/>
                <Button x:Name="BtnSave"
                        Content="保存"
                        Style="{StaticResource ActionButtonStyle}"
                        Click="BtnSave_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>

