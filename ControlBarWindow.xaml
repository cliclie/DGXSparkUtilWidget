<Window x:Class="DGXSparkUtilWidget.ControlBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="180" Height="32"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False">

    <Window.Resources>
        <!-- コントロールバーのボタン共通スタイル -->
        <Style x:Key="ControlButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Width="32" Height="32">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#40FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#60FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- クローズボタンの専用スタイル（ホバーで赤くなる） -->
        <Style x:Key="CloseButtonStyle" TargetType="Button" BasedOn="{StaticResource ControlButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Width="32" Height="32">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#E81123"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#C50F1F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="8" Background="#CC1E1E2E">
        <StackPanel Orientation="Horizontal">
            <!-- 最小化ボタン -->
            <Button x:Name="BtnMinimize"
                    Style="{StaticResource ControlButtonStyle}"
                    ToolTip="最小化">
                <Path Data="M 4,16 L 24,16"
                      Stroke="#E0E0E0" StrokeThickness="2"/>
            </Button>

            <!-- 最大化/元に戻すボタン -->
            <Button x:Name="BtnMaximizeRestore"
                    Style="{StaticResource ControlButtonStyle}"
                    ToolTip="最大化 / 元に戻す">
                <Path x:Name="IconMaximize"
                      Data="M 5,5 L 23,5 L 23,23 L 5,23 Z"
                      Stroke="#E0E0E0" StrokeThickness="2"
                      Fill="Transparent"/>
            </Button>

            <!-- 閉じるボタン -->
            <Button x:Name="BtnClose"
                    Style="{StaticResource CloseButtonStyle}"
                    ToolTip="閉じる">
                <Path Data="M 8,8 L 20,20 M 20,8 L 8,20"
                      Stroke="#E0E0E0" StrokeThickness="2"/>
            </Button>

            <!-- ハンバーガーメニューボタン -->
            <Button x:Name="BtnMenu"
                    Style="{StaticResource ControlButtonStyle}"
                    ToolTip="設定">
                <Path Data="M 4,7 L 24,7 M 4,12 L 24,12 M 4,17 L 24,17"
                      Stroke="#E0E0E0" StrokeThickness="2"/>
            </Button>

            <!-- Web操作トグルボタン -->
            <Button x:Name="BtnWebToggle"
                    Style="{StaticResource ControlButtonStyle}"
                    ToolTip="Webページ操作を有効化">
                <Path Data="M 6,3 L 6,19 L 11,14 L 15,21 L 18,19 L 14,12 L 20,10 Z"
                      Stroke="#E0E0E0" StrokeThickness="1.5"
                      Fill="Transparent"/>
            </Button>
        </StackPanel>
    </Border>
</Window>