<Window x:Class="DGXSparkUtilWidget.ControlBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="230" Height="32"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False">

    <Window.Resources>
        <!-- コントロールバーのボタン共通スタイル -->
        <Style x:Key="ControlButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#444444"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Width="46" Height="32">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#40000000"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#66000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- クローズボタンの専用スタイル（ホバーで赤くなる） -->
        <Style x:Key="CloseButtonStyle" TargetType="Button" BasedOn="{StaticResource ControlButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Width="46" Height="32">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#E81123"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#C50F1F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="8" Background="#99FFFFFF">
        <StackPanel Orientation="Horizontal">
            <!-- Web操作トグルボタン -->
            <Button x:Name="BtnWebToggle"
                    Style="{StaticResource ControlButtonStyle}"
                    ToolTip="Webページ操作を有効化">
                <Viewbox Width="18" Height="18">
                    <!-- geometry は原点起点・描画実寸（bbox+ストローク）を Path のサイズに明示し、Viewbox が正しく中央配置する -->
                    <Path Data="M 0.75,0.75 L 0.75,16.75 L 5.75,11.75 L 9.75,18.75 L 12.75,16.75 L 8.75,9.75 L 14.75,7.75 Z"
                          Width="15.5" Height="19.5"
                          Stroke="#444444" StrokeThickness="1.5"
                          Fill="Transparent"/>
                </Viewbox>
            </Button>

            <!-- ハンバーガーメニューボタン -->
            <Button x:Name="BtnMenu"
                    Style="{StaticResource ControlButtonStyle}"
                    ToolTip="設定">
                <!-- 設定は他のアイコンよりやや大きく（20）。3本の間隔を等間隔に -->
                <Viewbox Width="20" Height="20">
                    <Path Data="M 1,1 L 19,1 M 1,7.5 L 19,7.5 M 1,14 L 19,14"
                          Width="20" Height="15"
                          Stroke="#444444" StrokeThickness="2"/>
                </Viewbox>
            </Button>

            <!-- 最小化ボタン -->
            <Button x:Name="BtnMinimize"
                    Style="{StaticResource ControlButtonStyle}"
                    ToolTip="最小化">
                <!-- 下線は下端から8pxの下配置（中央配置にしない） -->
                <Grid Width="46" Height="32">
                    <Path Data="M 1,1 L 21,1"
                          Width="22" Height="2"
                          Stroke="#444444" StrokeThickness="2"
                          HorizontalAlignment="Center" VerticalAlignment="Bottom"
                          Margin="0,0,0,8"/>
                </Grid>
            </Button>

            <!-- 最大化/元に戻すボタン -->
            <Button x:Name="BtnMaximizeRestore"
                    Style="{StaticResource ControlButtonStyle}"
                    ToolTip="最大化 / 元に戻す">
                <Viewbox Width="18" Height="18">
                    <Path x:Name="IconMaximize"
                          Data="M 1,1 L 19,1 L 19,19 L 1,19 Z"
                          Width="20" Height="20"
                          Stroke="#444444" StrokeThickness="2"
                          Fill="Transparent"/>
                </Viewbox>
            </Button>

            <!-- 閉じるボタン -->
            <Button x:Name="BtnClose"
                    Style="{StaticResource CloseButtonStyle}"
                    ToolTip="閉じる">
                <Viewbox Width="18" Height="18">
                    <Path Data="M 1,1 L 13,13 M 13,1 L 1,13"
                          Width="14" Height="14"
                          Stroke="#444444" StrokeThickness="2"/>
                </Viewbox>
            </Button>
        </StackPanel>
    </Border>
</Window>